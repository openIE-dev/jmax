# Hello, JMax — solve a system, inspect the spectrum, return a determinant.
# Run:  jmax run examples/hello/hello.jm
let A = [[2.0, 1.0], [1.0, 3.0]]
let b = [5.0, 10.0]
let x = A \ b            # solve A x = b   -> [1, 3]
let spectrum = eig(A)    # eigenvalues     -> [3.618, 1.382]
det(A)                   # program result  -> 5
